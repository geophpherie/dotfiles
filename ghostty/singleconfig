font-family = "FiraCode Nerd Font Mono"
font-size = 14

theme = TokyoNight Night

background-image = "/Users/jbeyer/Pictures/crater-lake5-ghostty.jpg"
background-image-fit = stretch 

keybind = ctrl+super+j=goto_split:down
keybind = ctrl+super+k=goto_split:up
keybind = ctrl+super+l=goto_split:right
keybind = ctrl+super+h=goto_split:left

keybind = ctrl+super+s=new_split:down
keybind = ctrl+super+v=new_split:right

keybind = ctrl+super+enter=toggle_split_zoom

keybind = ctrl+super+p=toggle_command_palette
working-directory = ~/repos

# gtab managed include
config-file = "/Users/jbeyer/.config/gtab/ghostty-shortcut.conf"
